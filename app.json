{
  "expo": {
    "name": "Laura's Linguistics",
    "slug": "lauras-linguistics-android",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.molious.lauraslinguistics",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0A0612"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Laura's Linguistics to transcribe messages when you tap the microphone.",
          "speechRecognitionPermission": "Allow Laura's Linguistics to recognise your spoken messages."
        }
      ],
      "./plugins/withTrustedWebView.cjs"
    ],
    "owner": "molious",
    "extra": {
      "eas": {
        "projectId": "22ebbdc6-ec6b-469e-b552-83347020758b"
      }
    }
  }
}
